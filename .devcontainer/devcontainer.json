{
  "name": "GitOps Lab",
  "remoteUser": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  /* ===============================
     System Requirements
     =============================== */
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "100gb"
  },
  /* ===============================
     Runtime (privileged for Docker-in-Docker & kind)
     =============================== */
  "runArgs": [
    "--privileged",
    "-p",
    "80:80",
    "-p",
    "443:443"
  ],
  /* ===============================
     Environment
     =============================== */
  "containerEnv": {
    "KUBECONFIG": "/home/ubuntu/.kube/config",
    "AWS_DEFAULT_REGION": "us-west-2",
    "AWS_ACCESS_KEY_ID": "test",
    "AWS_SECRET_ACCESS_KEY": "test",
    "LOCALSTACK_HOST": "localhost"
  },
  /* ===============================
     Initialize Folders on Host
     =============================== */
  "initializeCommand": "bash .devcontainer/scripts/init-host.sh",
  /* ===============================
     Mounts (GitOps-friendly)
     =============================== */
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.kube,target=/home/ubuntu/.kube,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/home/ubuntu/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.zsh_history_devcontainers,target=/home/ubuntu/.zsh_history,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/Documents/Projects,target=/workspaces/Projects,type=bind,consistency=cached"
  ],
  /* ===============================
     Features
     =============================== */
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  /* ===============================
     Port Forwarding (Ingress access)
     =============================== */
  "forwardPorts": [
    80,
    443
  ],
  /* ===============================
     VS Code (minimal – defer to repo)
     =============================== */
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "hashicorp.terraform",
        "XargsUK.checkov-prismaless",
        "Anthropic.claude-code",
        "DavidAnson.vscode-markdownlint",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "workbench.startupEditor": "readme"
      }
    }
  },
  /* ===============================
     Lifecycle
     =============================== */
  "postCreateCommand": "/home/ubuntu/.local/bin/post-create.sh",
  "postStartCommand": "/home/ubuntu/.local/bin/post-start.sh",
  "shutdownAction": "stopContainer",
  "workspaceFolder": "/workspaces"
}
